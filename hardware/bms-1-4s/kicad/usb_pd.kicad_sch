  (global_label "VBUS_SYS" (shape bidirectional) (at 55.88 243.84 270) (fields_autoplaced)
    (effects (font (size 1.27 1.27)) (justify right))
    (uuid "18a1ea6b-cf0a-5932-9d0d-3922258dcc65")
